// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {  // Modelo se chamará User 
  id       Int    @id @default(autoincrement())  // @id = define o campo como chave Primária @default(autoincrement() = banco gera o ID automaticamente
  name     String
  email    String @unique
  password String

  sessions Session[]
}

 model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}